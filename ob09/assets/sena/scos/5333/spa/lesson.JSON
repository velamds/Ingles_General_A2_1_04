"type": "definition", "content": "talk; conversation"}, {"type": "part_speech", "content": "noun"}, {"type": "example", "content": "Example: So great to have a chat with you!"}, {"type": "audio", "content": "engenn4le04ob09aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you talk about a skiing trip."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hat"}, {"type": "definition", "content": "a clothing accessory you wear on your head"}, {"type": "part_speech", "content": "noun"}, {"type": "example", "content": "Example: I'm taking a hat, goggles and gloves with me."}, {"type": "audio", "content": "engenn4le04ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "goggles"}, {"type": "definition", "content": "glasses for skiing"}, {"type": "part_speech", "content": "noun"}, {"type": "example", "content": "Example: I need to buy a pair of goggles to go skiing."}, {"type": "audio", "content": "engenn4le04ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gloves"}, {"type": "definition", "content": "protection from the cold for the hands"}, {"type": "part_speech", "content": "noun"}, {"type": "example", "content": "Example: It's cold. You need your gloves."}, {"type": "audio", "content": "engenn4le04ob09aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "skis"}, {"type": "definition", "content": "long thin boards used for skiing"}, {"type": "part_speech", "content": "noun"}, {"type": "example", "content": "Example: I'm going to rent skis."}, {"type": "audio", "content": "engenn4le04ob09aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "poles"}, {"type": "definition", "content": "sticks used for skiing"}, {"type": "part_speech", "content": "noun"}, {"type": "example", "content": "Example: Can I use your poles today?"}, {"type": "audio", "content": "engenn4le04ob09aud05"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of a destination for a trip."}, {"type": "text", "content": "Think of 10 items you would normally take."}, {"type": "text", "content": "Write each item on a separate piece of paper."}, {"type": "text", "content": "Give your partner 10 seconds to look at all the pieces of papers."}, {"type": "text", "content": "Your partner closes their eyes. You remove 2 items."}, {"type": "text", "content": "Ask your partner to guess which items are missing. These are the items you need to get."}, {"type": "text", "content": "Discuss how to get those things."}, {"type": "text", "content": "Change roles and repeat."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I identify items for a trip. "}, {"type": "text", "content": "I discuss things I need to take on a trip."}]}], "type": "sena"}