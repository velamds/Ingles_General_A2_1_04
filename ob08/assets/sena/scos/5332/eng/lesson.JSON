y Chinese maiden. ", "type": ""}, "type": "post_question"}, {"content": "secondary_2", "type": "objective"}], "id": 2, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "saw", "type": "text"}], "id": 1}]}, {"_data": [{"contents": [{"content": "engenn4le04ob08re4aud05", "type": "audio"}, {"content": "It soon ", "type": "text"}], "type": "question"}, {"contents": {"content": "one of Italy's favorite foods.", "type": ""}, "type": "post_question"}, {"content": "secondary_2", "type": "objective"}], "id": 3, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "became", "type": "text"}], "id": 1}]}, {"_data": [{"contents": [{"content": "engenn4le04ob08re4aud06", "type": "audio"}, {"content": "After that, cooks on other ships ", "type": "text"}], "type": "question"}, {"contents": {"content": "to serve the strings as well.", "type": ""}, "type": "post_question"}, {"content": "secondary_2", "type": "objective"}], "id": 4, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "decided", "type": "text"}], "id": 1}]}, {"_data": [{"contents": [{"content": "", "type": "rec"}], "type": "question"}, {"content": "secondary_2", "type": "objective"}], "id": 5, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}]}], "type": "TYP", "_data": [{"contents": [{"content": "Can you remember the short story? ", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Activity 2", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Listening", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: <span class = \"bullet\">Listen to the audio.</span> <span class = \"bullet\">Type in the missing words. </span><span class = \"bullet\"> Record yourself saying the sentences aloud. </span> <span class = \"bullet\">Compare yourself to the audio. </span> ", "type": "text"}, {"content": "You have 2 attempts to submit your answers.", "type": "text"}], "type": "post_instructions"}], "id": 2, "stimuli_ids": []}, {"template_override": 1, "questions": [{"_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 0, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}]}, {"_data": [{"contents": [{"content": "Decide what type of story you are writing.", "type": "text"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 1, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}]}, {"_data": [{"contents": [{"content": "Choose the characters, narrator and the setting. Example: Who? What? Where?", "type": "text"}], "type": "question"}, {"content": "secondary_3", "type": "objective"}], "id": 2, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}]}, {"_data": [{"contents": [{"content":