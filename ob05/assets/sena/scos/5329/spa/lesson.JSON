ent": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}]}, {"type": "tips", "content": [{"type": "text", "tip_id": 0, "content": "\u201c<span class=\"italic\">Chicken</span>\u201d is a non-count noun. It is a substance."}, {"type": "text", "tip_id": 1, "content": "\u201c<span class=\"italic\">Stick</span>\u201d is a count noun. It is something you can count."}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Select all the correct answers. "}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}], "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa in Cooking School: Italian Food"}, {"type": "unit_name", "content": "A Tasty Challenge"}, {"type": "position", "content": 5}, {"type": "origin", "content": "scholar > Taking a Break > Alps"}, {"type": "lesson", "content": 4}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Quantifiers with Count and Non-Count Nouns"}, {"type": "describer", "content": " "}, {"type": "text", "content": "Count nouns are things we can count."}, {"type": "text", "content": "<ul><li>They can be singular or plural (a lemon, two sticks).  </li> <li>You can use <span class=\"strong\">some</span>  and <span class=\"strong\">any </span> with count nouns.</li>  <span class=\"italic\">Example: some chicken sticks </span> <li>You can also use a <span class=\"strong\">few</span>  and <span class=\"strong\">many</span> .</li><span class=\"italic\">Example: many lemons</span> </ul> "}, {"type": "text", "content": "Non-count nouns are things that we cannot divide into separate things.  They are materials, substances or amounts."}, {"type": "text", "content": " <ul><li>They are usually considered singular. You do not put an s at the end.</li> <span class=\"italic\">Example:This olive oil is very good.</span>  <li>You can use <span class=\"strong\">some</span>  and <span class=\"strong\">any</span>  with non-count nouns.</li> <span class=\"italic\">Example: some lemon juice </span> <li>We can use <span class=\"strong\">a little</span>  and <span class=\"strong\">much</span>  with non-count nouns.</li><span class=\"italic\"> Example: a little lemon juice</span> "}, {"type": "example", "content": "<span class=\"strong\">Tony</span>: Do you want to make some chicken sticks?<br /><span class=\"strong\">Amy</span>:  Sure do we need much lemon juice?<br /><span class=\"strong\">Tony</span>: Just a little.<br /><span class=\"strong\">Amy</span>:  How many chicken sticks are you making?</span><br /><span class=\"strong\">Tony</span>: Not too many, only a few."}]}, {"type": "background_image", "content": "engenn4le04ob05re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "assignment  "}, {"type": "definition", "content": "a project you have to complete"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: My Aunt Nelly is going to like this assignment!"}, {"type": "audio", "content": "engenn4le04ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear in cooking school."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "task  "}, {"type": "definition", "content": "something you have to do "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I have an exciting homework task for you before we finish today."}, {"type": "audio", "content": "engenn4le04ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "partner  "}, {"type": "definition", "content": "someone you work with "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Give your recipe to your partner tomorrow morning."}, {"type": "audio", "content": "engenn4le04ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "olive oil   "}, {"type": "definition", "content": "a thick liquid used in cooking"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You can use olive oil to fry onions."}, {"type": "audio", "content": "engenn4le04ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "peanut butter "}, {"type": "definition", "content": "a peanut paste often spread on bread "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Many children like eating peanut butter."}, {"type": "audio", "content": "engenn4le04ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "salmon   "}, {"type": "definition", "content": "a type of fish"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You can make salmon macaroni and cheese!"}, {"type": "audio", "content": "engenn4le04ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to grate "}, {"type": "definition", "content": "to cut something (like cheese or onions) into very small pieces with a grater "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Just grate the cheese and add it on top of the pasta."}, {"type": "audio", "content": "engenn4le04ob05aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Make a list of 15 - 20 ingredients."}, {"type": "text", "content": "Number the ingredients #1 - #20."}, {"type": "text", "content": "Ask your partner to choose 3 numbers. These are the ingredients you have to use to make your dish."}, {"type": "text", "content": "Think of a unique dish you can make."}, {"type": "text", "content": "Explain your dish to your partner."}, {"type": "text", "content": "Choose 3 numbers for your partner. Ask your partner to invent a dish."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I identify ingredients to use in cooking."}, {"type": "text", "content": "I describe a new dish to a partner."}, {"type": "text", "content": "I listen to description about a new dish."}]}], "type": "sena"}